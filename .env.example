# ============================================================
# Placement Coach AI — Environment Variables
# Copy this file to `.env` and fill in your own values.
# `.env` is git-ignored and must NEVER be committed.
# ============================================================

# MongoDB connection string (local or Atlas)
MONGODB_URI=mongodb://127.0.0.1:27017/placement_coach

# Secret used to sign/verify JWT access tokens (use a long random string)
JWT_SECRET=

# Optional: token lifetime (default: 7d)
JWT_EXPIRES_IN=7d

# Google Gemini API key — server side only, never sent to the browser
GEMINI_API_KEY=

# Optional: Gemini model override (fallback chain is applied automatically)
GEMINI_MODEL=gemini-3.6-flash

# Judge0-compatible code execution provider (server side only, never sent to the browser).
# Leave JUDGE0_API_URL unset to use the public Judge0 CE instance (https://ce.judge0.com).
# RapidAPI Judge0 users: set JUDGE0_API_URL + JUDGE0_API_KEY + JUDGE0_API_HOST.
JUDGE0_API_URL=
JUDGE0_API_KEY=
JUDGE0_API_HOST=

# Backend HTTP port
PORT=5000

# Allowed browser origin for CORS (frontend dev server / deployment URL)
CLIENT_URL=http://localhost:5500

# development | production | test
NODE_ENV=development
